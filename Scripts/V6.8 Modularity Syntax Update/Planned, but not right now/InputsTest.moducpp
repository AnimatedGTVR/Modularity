add ModuCPP;
add ModuInput;
public class InputsTest : ModuNode {
    // This is when we add OpenXR Support in the future lol.
    public SceneObj[] enable;
    public SceneObj[] disable;
    public bool ShouldEnableAndDisable;
    void Begin() to ShouldEnableAndDisable = true;
    void TickUpdate() {
        if (ShouldEnableAndDisable) {
            if (XR.Left.Trigger(Down))     then each disable.state(true);
            else if (XR.Left.Trigger(Up))  then each enable.state(true);
            if (XR.Right.Trigger(Down))    then each disable.state(false);
            else if (XR.Right.Trigger(Up)) then each enable.state(false);
        }
    }  
}